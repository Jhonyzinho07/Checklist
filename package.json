{
  "name": "checklist-teto-mercury",
  "version": "1.0.0",
  "description": "App local de checklist de produção (Teto Mercury) com geração de PDF",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "build:exe": "caxa --input . --output dist/checklist-teto-mercury.exe --exclude dist checklists_preenchidos .git -- \"{{caxa}}/node_modules/.bin/node\" \"{{caxa}}/server.js\""
  },
  "dependencies": {
    "express": "^4.19.2",
    "pdfkit": "^0.15.0"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.23.0",
    "caxa": "^3.0.1",
    "nodemon": "^3.1.14"
  }
}
